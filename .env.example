# A Base Sepolia TEST key with a little ETH (never a mainnet key). The agent tools sign with it.
AGENT_PRIVATE_KEY=
# Where the paid endpoint's payments go (any Base Sepolia address; default: the agent's own address)
PAY_TO=
# Any OpenAI-compatible provider for the /agent page. Free tiers work.
GROQ_API_KEY=
GEMINI_API_KEY=
# Optional: Base Sepolia RPC (default: the public one) and WalletConnect (opt-in)
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
