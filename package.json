  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.94",
    "@codkit/agent-tools": "0.1.1",
    "@codkit/config": "^0.1.2",
    "@codkit/mcp": "^0.3.0",
    "@codkit/pay": "^0.1.2",
    "@codkit/policy": "^0.1.1",
    "@codkit/ui": "0.2.0",
    "@codkit/wallet": "0.1.2",
    "@solana-program/system": "^0.16.0",
    "@solana-program/token": "^0.18.0",
    "@solana/kit": "^8.6.0",
    "@tanstack/react-query": "^5.108.4",
    "@x402/hono": "~2.28.0",
    "ai": "^7.0.181",
    "hono": "^4.13.21",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "viem": "^2.58.6",
    "wagmi": "^3.7.11",
