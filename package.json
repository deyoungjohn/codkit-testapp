{
  "name": "codkit-testapp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "A hackathon-style app outside the codkit workspace: it installs @codkit/* from npm, to prove they work the way a team uses them.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
